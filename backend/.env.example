# =====================================================
# Backend (Express) environment variables.
# Copy to `backend/.env` and fill in real values.
# Server-side secrets only. NEVER commit the real .env.
# =====================================================

# --- Runtime ---
NODE_ENV=development
BACKEND_PORT=5000

# --- Secrets (REQUIRED in production, min 32 chars, must differ from each other) ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string-32-chars

# --- Database (Postgres connection string used by Prisma) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/school_app

# DIRECT_URL is required in production when using a connection pooler (e.g. Supabase pooler,
# PgBouncer). Prisma Migrate needs a direct, session-mode connection — not a pooled one.
# Set this to the direct (non-pooled) connection string. In development it can be omitted.
DIRECT_URL=postgresql://postgres:password@localhost:5432/school_app

# --- Supabase (server-side, SERVICE ROLE key — never expose to browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Demo school (must be set in prod; dev falls back to known UUIDs) ---
DEMO_SCHOOL_ID=your-demo-school-uuid
DEMO_BRANCH_ID=your-demo-branch-uuid

# --- Demo seeder (runs on every boot by default, including production — the demo
# school must always be populated. Safe to leave on: it only upserts deterministic
# demo records, never touches real school data. Set to false only to explicitly
# disable it.) ---
RUN_DEMO_SEEDER=true

# --- SMTP (Gmail or other; if blank, dev falls back to Ethereal preview inbox) ---
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- App URL (used in email templates) ---
APP_URL=https://app.oliskey.com

# --- CORS (comma-separated list of additional allowed origins) ---
CORS_ALLOWED_ORIGINS=

# --- Redis (background job queue, rate limiting, CSRF replay guard, cache).
# Optional — every consumer falls back to safe in-memory behaviour when Redis
# is unreachable, but Redis is required for correct rate limiting/CSRF replay
# protection across more than one backend instance/process. ---
REDIS_URL=redis://localhost:6379

# --- Rate limiting (Redis-backed, tiered — see middleware/rateLimiters.ts) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1800          # per shared IP, per window (~30 r/s)
RATE_LIMIT_USER_MAX=3600     # per authenticated user, per window (~60 r/s)
RATE_LIMIT_LOGIN_MAX=5               # per 15-minute window, per IP
RATE_LIMIT_SIGNUP_MAX=10             # per 1-hour window, per IP
RATE_LIMIT_PASSWORD_RESET_MAX=5      # per 1-hour window, per IP
RATE_LIMIT_DEMO_MAX=1000             # per 15-minute window, per IP
RATE_LIMIT_EXPORT_MAX=10             # per 1-hour window, per IP

# --- CSRF cookie SameSite policy. "lax" is correct when nginx serves the SPA
# and API same-origin (the default deployment — see deploy/nginx.conf). Only
# set to "none" if the API is ever deployed on a different origin than the SPA. ---
CSRF_SAMESITE=lax

# --- HTTP Keep-Alive (must stay ahead of the reverse proxy's upstream idle
# timeout — see deploy/nginx.conf's `upstream { keepalive_timeout }`) ---
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000

# --- Socket.io Redis pub/sub adapter — only needed once running more than one
# backend instance/process (horizontal scaling). No effect on a single node. ---
SOCKET_REDIS_ADAPTER=false

# --- Body parser limit (e.g. 2mb, 10mb) ---
BODY_LIMIT=2mb

# --- AI (NVIDIA is the default provider, proxied through this backend so the
# key never reaches the browser bundle — see lib/ai.ts / VITE_AI_PROVIDER) ---
NVIDIA_API_KEY=

# --- Error monitoring (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
