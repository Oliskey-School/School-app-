# =====================================================
# Backend (Express) environment variables.
# Copy to `backend/.env` and fill in real values.
# Server-side secrets only. NEVER commit the real .env.
# =====================================================

# --- Runtime ---
NODE_ENV=development
BACKEND_PORT=5000

# --- Secrets (REQUIRED in production, min 32 chars, must differ from each other) ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string-32-chars

# --- Database (Postgres connection string used by Prisma) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/school_app

# DIRECT_URL is required in production when using a connection pooler (e.g.
# PgBouncer, or a managed Postgres provider's pooler). Prisma Migrate needs a
# direct, session-mode connection — not a pooled one. Set this to the direct
# (non-pooled) connection string. In development it can be omitted.
DIRECT_URL=postgresql://postgres:password@localhost:5432/school_app

# --- Demo school (must be set in prod; dev falls back to known UUIDs) ---
DEMO_SCHOOL_ID=your-demo-school-uuid
DEMO_BRANCH_ID=your-demo-branch-uuid

# --- Demo seeder (runs on every boot by default, including production — the demo
# school must always be populated. Safe to leave on: it only upserts deterministic
# demo records, never touches real school data. Set to false only to explicitly
# disable it.) ---
RUN_DEMO_SEEDER=true

# --- SMTP (Gmail or other; if blank, dev falls back to Ethereal preview inbox) ---
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- App URL (used in email templates) ---
APP_URL=https://app.oliskey.com

# --- CORS. In production this is OFF by default — nginx serves the SPA and
# proxies /api same-origin, so the browser never needs CORS headers (see
# deploy/nginx.conf). Only needed if you deploy the API on a different origin
# than the frontend without a same-origin proxy in front of it. In
# development it's always on (Vite dev server calls the API cross-origin). ---
ENABLE_CORS=false

# --- Trust proxy hop count for rate limiting / req.ip accuracy. 1 = one
# reverse proxy (nginx) in front, matching the default deploy/nginx.conf
# setup. Increase if there's an additional layer (e.g. a CDN/WAF) in front
# of nginx. ---
TRUST_PROXY=1

# --- Redis (background job queue, rate limiting, CSRF replay guard, cache).
# Optional — every consumer falls back to safe in-memory behaviour when Redis
# is unreachable, but Redis is required for correct rate limiting/CSRF replay
# protection across more than one backend instance/process. ---
REDIS_URL=redis://localhost:6379

# --- Rate limiting (Redis-backed, tiered — see middleware/rateLimiters.ts) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1800          # per shared IP, per window (~30 r/s)
RATE_LIMIT_USER_MAX=3600     # per authenticated user, per window (~60 r/s)
RATE_LIMIT_LOGIN_MAX=5               # per 15-minute window, per IP
RATE_LIMIT_SIGNUP_MAX=10             # per 1-hour window, per IP
RATE_LIMIT_PASSWORD_RESET_MAX=5      # per 1-hour window, per IP
RATE_LIMIT_DEMO_MAX=1000             # per 15-minute window, per IP
RATE_LIMIT_EXPORT_MAX=10             # per 1-hour window, per IP

# --- CSRF cookie SameSite policy. "lax" is correct when nginx serves the SPA
# and API same-origin (the default deployment — see deploy/nginx.conf). Only
# set to "none" if the API is ever deployed on a different origin than the SPA. ---
CSRF_SAMESITE=lax

# --- HTTP Keep-Alive (must stay ahead of the reverse proxy's upstream idle
# timeout — see deploy/nginx.conf's `upstream { keepalive_timeout }`) ---
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000

# --- Socket.io Redis pub/sub adapter — only needed once running more than one
# backend instance/process (horizontal scaling). No effect on a single node. ---
SOCKET_REDIS_ADAPTER=false

# --- Body parser limit (e.g. 2mb, 10mb) ---
BODY_LIMIT=2mb

# --- AI (NVIDIA is the default provider, proxied through this backend so the
# key never reaches the browser bundle — see lib/ai.ts / VITE_AI_PROVIDER) ---
NVIDIA_API_KEY=

# --- Whole-app translation (Gemini key; server-side only). Without this,
# translation degrades gracefully to English. Accepts GOOGLE_TRANSLATE_API_KEY,
# or the common aliases GOOGLE_API_KEY / GEMINI_API_KEY. ---
GOOGLE_TRANSLATE_API_KEY=

# --- Payments (server-side SECRET keys — never expose to the browser; the
# matching PUBLIC keys live in the frontend .env as VITE_PAYSTACK_PUBLIC_KEY /
# VITE_FLUTTERWAVE_PUBLIC_KEY) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx

# --- Google Sign-In. Must match the frontend's VITE_GOOGLE_CLIENT_ID — the
# backend verifies the Google ID token's `aud` claim against this so sign-in
# can't be spoofed by posting an arbitrary email/name directly to the login
# endpoint. Has a working default baked into code for the demo school; set
# your own for a real deployment. ---
GOOGLE_CLIENT_ID=

# --- Daily.co API key for live-class video rooms (server-side only — the
# browser only ever sees the join URL this backend mints). Leave unset to
# fall back to the Jitsi path instead. ---
DAILY_API_KEY=

# --- File uploads (student/teacher photos, documents, assignments, resources).
# Leave S3_ENABLED=false to store on local disk under ./uploads (fine for
# dev, and for a single-instance deployment where the disk persists across
# restarts). Set S3_ENABLED=true + the rest below for any S3-compatible
# object storage (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces,
# Contabo Object Storage, MinIO, ...) — required once the app ever runs as
# more than one instance, or on any host where local disk isn't guaranteed
# to survive a redeploy. ---
S3_ENABLED=false
S3_BUCKET=
S3_REGION=auto
# Leave blank for real AWS S3; set to the provider's endpoint for anything
# else, e.g. https://<account-id>.r2.cloudflarestorage.com for R2.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Several non-AWS providers need path-style requests (bucket.host/key
# doesn't resolve for them) — set true for those, leave false for AWS S3.
S3_FORCE_PATH_STYLE=false
# Public base URL files are served from — either the bucket's own public
# endpoint or a CDN domain in front of it. Returned upload URLs are
# `${S3_PUBLIC_URL_BASE}/<bucket>/<path>`.
S3_PUBLIC_URL_BASE=

# --- Error monitoring (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
