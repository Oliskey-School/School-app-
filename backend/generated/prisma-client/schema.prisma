  subject                String
  teacher_id             String?
  day_of_week            Int?
  start_time             String
  end_time               String
  room                   String?
  classroom_id           String?
  notes                  String?
  status                 String                 @default("Draft")
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  branch                 Branch?                @relation(fields: [branch_id], references: [id])
  class                  Class?                 @relation(fields: [class_id], references: [id], onDelete: Cascade)
  school                 School                 @relation(fields: [school_id], references: [id], onDelete: Cascade)
  teacher                Teacher?               @relation(fields: [teacher_id], references: [id])
  classroom              Classroom?             @relation(fields: [classroom_id], references: [id])
  lesson_attendance      LessonAttendance[]
  substitute_assignments SubstituteAssignment[]
  created_by             String?
  updated_by             String?
  deleted_at             DateTime?
}

// Physical classroom (per branch) with a permanent QR token used for teacher
// lesson check-in/out. The qr_token is a server-generated random string —
// never guessable, never exposed as anything but the QR payload.
model Classroom {
  id                String             @id @default(uuid())
  school_id         String
  branch_id         String
  name              String
  description       String?
  capacity          Int?
  qr_token          String             @unique
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  created_by        String?
  updated_by        String?
  deleted_at        DateTime?
  school            School             @relation(fields: [school_id], references: [id], onDelete: Cascade)
  branch            Branch             @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  timetables        Timetable[]
  lesson_attendance LessonAttendance[]

  @@unique([branch_id, name])
}

// One record per teacher-lesson-day, created on the first QR scan (or by the
// nightly sweep for lessons never scanned). Subject/class are snapshotted so
// reports stay accurate even if the timetable is edited later.
model LessonAttendance {
  id                 String    @id @default(uuid())
  school_id          String
  branch_id          String?
  timetable_id       String
  teacher_id         String
  classroom_id       String
  date               String // YYYY-MM-DD
  subject            String
  class_name         String?
  scheduled_start    String // HH:MM (from timetable)
  scheduled_end      String // HH:MM
  scan_in_at         DateTime?
  scan_out_at        DateTime?
  duration_minutes   Int?
  // completed | in_progress | no_scan_out | missed. Lateness/early departure
  // are separate flags so one lesson can be both late AND early-departure.
  status             String    @default("in_progress")
  is_late            Boolean   @default(false)
  is_early_departure Boolean   @default(false)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  created_by         String?
  updated_by         String?
  deleted_at         DateTime?
  school             School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  branch             Branch?   @relation(fields: [branch_id], references: [id])
  timetable          Timetable @relation(fields: [timetable_id], references: [id], onDelete: Cascade)
  teacher            Teacher   @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  classroom          Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  @@unique([timetable_id, date])
  @@index([school_id, date])
  @@index([teacher_id, date])
}

// Permanent personnel-file entry for a teacher: promotions, warnings,
// commendations, disciplinary notes. Entries are never hard-deleted — the
// file is a permanent employment record.
model TeacherRecord {
  id              String    @id @default(uuid())
  school_id       String
  branch_id       String?
  teacher_id      String
  // promotion | warning | commendation | disciplinary | note
  type            String
  title           String
  details         String?
  effective_date  String? // YYYY-MM-DD
  attachment_urls String[]  @default([])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  created_by      String?
  updated_by      String?
  deleted_at      DateTime?
  school          School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  branch          Branch?   @relation(fields: [branch_id], references: [id])
  teacher         Teacher   @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([teacher_id, type])
  @@index([school_id, teacher_id])
}

// A formal query letter issued by an admin to a teacher, with the teacher's
// written response and the admin's closing outcome. Letter + response live on
// one row: the exchange is a single formal document in the personnel file.
model QueryLetter {
  id                       String    @id @default(uuid())
  school_id                String
  branch_id                String?
  teacher_id               String
  subject                  String
  reason                   String
  issue_date               String // YYYY-MM-DD
  response_deadline        String // YYYY-MM-DD
  attachment_urls          String[]  @default([])
  // pending | responded | resolved | warning_issued | escalated
  status                   String    @default("pending")
  issued_by                String?
  issued_by_name           String?
  response_text            String?
  response_attachment_urls String[]  @default([])
  responded_at             DateTime?
  is_late_response         Boolean   @default(false)
  outcome_note             String?
  closed_by                String?
  closed_at                DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  created_by               String?
  updated_by               String?
  deleted_at               DateTime?
  school                   School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  branch                   Branch?   @relation(fields: [branch_id], references: [id])
  teacher                  Teacher   @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([teacher_id, status])
  @@index([school_id, teacher_id])
}

model VirtualClassSession {
  id            String                   @id @default(uuid())
  school_id     String
  branch_id     String?
  teacher_id    String?
  class_id      String?
  title         String
  subject       String?
  topic         String?
  description   String?
  meeting_url   String?
  platform      String                   @default("zoom")
  start_time    DateTime
  end_time      DateTime?
  status        String                   @default("scheduled")
  meeting_id    String?
