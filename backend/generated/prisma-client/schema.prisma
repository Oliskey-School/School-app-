// ============================================
// GLOBAL TEACHER COMMUNITY (cross-school)
// Deliberately NOT scoped by school_id/branch_id: this is the one place where
// teachers from different schools share a space. Only the message text + a
// non-identifying author label (first name + role) is ever stored/returned —
// never school, branch, IDs, contact, or any other tenant data. This is an
// owner-sanctioned, explicit exception to strict tenant isolation.
// ============================================

model GlobalForumTopic {
  id            String   @id @default(uuid())
  title         String
  content       String?
  author_id     String?
  author_name   String?
  author_role   String?  @default("teacher")
  post_count    Int      @default(0)
  is_locked     Boolean  @default(false)
  last_activity DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  @@index([last_activity])
}

model GlobalForumPost {
  id          String   @id @default(uuid())
  topic_id    String
  author_id   String?
  author_name String?
  author_role String?  @default("teacher")
  content     String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@index([topic_id])
}

// ============================================
// PER-BRANCH IDENTITY
// A user (e.g. a teacher assigned to multiple branches) gets a stable, unique
// Global ID PER branch: {SCHOOL}_{BRANCH}_{ROLE}_{NUMBER}. The number reuses the
// user's home number when it's free in the target branch, otherwise the next
// available number for that branch+role. This row reserves it so it never moves.
// ============================================

model BranchUserIdentity {
  id                  String    @id @default(uuid())
  school_id           String
  branch_id           String
  user_id             String
  role                String
  number              Int
  school_generated_id String
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt
  created_by          String?
  updated_by          String?
  deleted_at          DateTime?

  @@unique([user_id, branch_id])
  @@unique([school_id, branch_id, role, number])
  @@index([school_id, branch_id])
}

