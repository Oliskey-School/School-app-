// STUDENT DEPARTURE (Gate Pass + Pickup Authorization, combined). Parents
// maintain a standing list of people allowed to collect their child; every
// departure — routine end-of-day pickup or a mid-day early dismissal — is
// checked against that same list and confirmed by staff.
model AuthorizedPickupPerson {
  id           String   @id @default(uuid())
  school_id    String
  branch_id    String?
  student_id   String
  name         String
  relationship String
  phone        String?
  photo_url    String?
  is_active    Boolean  @default(true)
  added_by     String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  school       School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, is_active])
}

model StudentDeparture {
  id                 String    @id @default(uuid())
  school_id          String
  branch_id          String?
  student_id         String
  type               String // EndOfDay | EarlyDismissal
  pickup_person_id   String?
  pickup_person_name String? // set when the person isn't a pre-registered AuthorizedPickupPerson — flags for staff review
  is_authorized      Boolean   @default(false)
  reason             String?
  status             String    @default("Pending") // Pending | Approved | Completed | Denied
  requested_by       String?
  approved_by        String?
  confirmed_by       String?
  departure_time     DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  school             School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student            Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([school_id, status])
  @@index([student_id])
}

// TEACHER WORKLOAD — non-teaching duties an admin assigns (exam supervision,
// detention duty, morning assembly, etc). Club/extracurricular advising is
// tracked directly on ExtracurricularActivity.advisor_teacher_id instead of a
