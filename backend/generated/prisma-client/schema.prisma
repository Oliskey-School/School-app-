// ============================================================================
// School SOP (Standard Operating Procedures) — configurable incident-response
// workflows. An admin defines an "incident type" (Bullying, Fire, Bus
// Accident...) with its own ordered sequence of stages; each report against
// that type walks the same sequence, notifying the right people, gathering
// evidence, and finishing in a permanent, auditable case record with an
// auto-drafted letter. Nothing is ever deleted — a case is closed, not
// removed, exactly like the query-letter/suspension permanent-record pattern
// used elsewhere in this app.
// ============================================================================

model SOPIncidentType {
  id                String             @id @default(uuid())
  school_id         String
  branch_id         String?
  name              String
  description       String?
  // 'standard' (staged investigation) | 'critical' (also fans out an
  // immediate real-time alert the moment a case is reported).
  severity          String             @default("standard")
  is_critical_alert Boolean            @default(false)
  // Audience for the critical-alert fan-out (ignored for standard types).
  alert_audience    String? // 'all' | 'staff' | 'parents' | 'teachers'
  is_active         Boolean            @default(true)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  created_by        String?
  updated_by        String?
  deleted_at        DateTime?
  school            School             @relation(fields: [school_id], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branch_id], references: [id])
  stages            SOPWorkflowStage[]
  cases             SOPCase[]

  @@index([school_id, is_active])
}

// One ordered stage in an incident type's workflow (e.g. "Vice Principal
// Notified", "Parent Notified", "Investigation", "Decision Recorded").
model SOPWorkflowStage {
  id                String          @id @default(uuid())
  incident_type_id  String
  order             Int
  name              String
  // Roles notified when a case reaches this stage (e.g. ['ADMIN']).
  notify_roles      String[]        @default([])
  // Specific users notified in addition to notify_roles (optional).
  notify_user_ids   String[]        @default([])
  requires_evidence Boolean         @default(false)
  requires_decision Boolean         @default(false)
  // The final stage of the workflow — completing it archives the case.
  is_terminal       Boolean         @default(false)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  incident_type     SOPIncidentType @relation(fields: [incident_type_id], references: [id], onDelete: Cascade)

  @@unique([incident_type_id, order])
  @@index([incident_type_id])
}

// A reported incident, walking through its type's stage sequence.
model SOPCase {
  id                   String            @id @default(uuid())
  school_id            String
  branch_id            String?
  incident_type_id     String
  title                String
  description          String
  // Free-form snapshots of names (never enforced FKs — students/teachers
  // named in a case may later leave/graduate, but the case record must stay
  // exactly as reported).
  involved_student_ids String[]          @default([])
  involved_teacher_ids String[]          @default([])
  reported_by          String
  reported_by_role     String
  // 'open' | 'in_progress' | 'resolved' | 'archived'
  status               String            @default("open")
  current_stage_order  Int               @default(1)
  critical_alert_sent  Boolean           @default(false)
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  closed_at            DateTime?
  created_by           String?
  updated_by           String?
  deleted_at           DateTime?
  school               School            @relation(fields: [school_id], references: [id], onDelete: Cascade)
  branch               Branch?           @relation(fields: [branch_id], references: [id])
  incident_type        SOPIncidentType   @relation(fields: [incident_type_id], references: [id])
  stage_logs           SOPCaseStageLog[]
  evidence             SOPEvidence[]
  decisions            SOPDecision[]
  letters              SOPLetter[]

  @@index([school_id, status])
  @@index([incident_type_id])
}

// Permanent, append-only history of every stage a case passed through.
model SOPCaseStageLog {
  id                String    @id @default(uuid())
  case_id           String
  stage_order       Int
  stage_name        String // snapshot — survives later edits to the workflow template
  // 'pending' | 'completed' | 'skipped'
  status            String    @default("pending")
  notes             String?
  notified_user_ids String[]  @default([])
  completed_by      String?
  completed_at      DateTime?
  created_at        DateTime  @default(now())
  case              SOPCase   @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
}

model SOPEvidence {
  id          String   @id @default(uuid())
  case_id     String
  url         String
  file_type   String?
  description String?
  uploaded_by String
  created_at  DateTime @default(now())
  case        SOPCase  @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
}

model SOPDecision {
  id                 String   @id @default(uuid())
  case_id            String
  decision_text      String
  // 'no_action' | 'warning' | 'suspension' | 'expulsion' | 'other'
  outcome            String   @default("no_action")
  decided_by         String
  decided_at         DateTime @default(now())
  // Set when the decision was one-click-linked to a permanent record
  // elsewhere in the app (TeacherRecord warning / StudentSuspension).
  linked_record_type String?
  linked_record_id   String?
  case               SOPCase  @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
}

model SOPLetter {
  id             String    @id @default(uuid())
  case_id        String
  draft_text     String
  final_text     String?
  // 'draft' | 'sent'
  status         String    @default("draft")
  recipient_type String? // 'parent' | 'student' | 'teacher' | 'other'
  recipient_id   String?
  generated_by   String
  sent_by        String?
  sent_at        DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  case           SOPCase   @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
}
