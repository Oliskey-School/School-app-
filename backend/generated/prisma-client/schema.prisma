// DEPARTMENT MANAGEMENT — Science, Mathematics, ICT, etc. A department has a
// Head of Department, a roster of teachers (Teacher.department_id), budget
// lines (Budget.department_id), and its own meeting log.
model Department {
  id              String              @id @default(uuid())
  school_id       String
  branch_id       String?
  name            String
  head_teacher_id String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  school          School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  head_teacher    Teacher?            @relation("DepartmentHead", fields: [head_teacher_id], references: [id], onDelete: SetNull)
  teachers        Teacher[]           @relation("DepartmentTeachers")
  budgets         Budget[]
  meetings        DepartmentMeeting[]
  created_by      String?
  updated_by      String?
  deleted_at      DateTime?

  @@unique([school_id, branch_id, name])
}

model DepartmentMeeting {
  id            String     @id @default(uuid())
  school_id     String
  branch_id     String?
  department_id String
  title         String
  date          DateTime
  time          String?
  agenda        Json?
  minutes       String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  department    Department @relation(fields: [department_id], references: [id], onDelete: Cascade)
  school        School     @relation(fields: [school_id], references: [id], onDelete: Cascade)
  created_by    String?
  updated_by    String?
  deleted_at    DateTime?

  @@index([department_id, date])
}

