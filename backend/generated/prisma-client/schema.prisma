// A substitute teacher covering one specific period for an absent teacher.
// Only created once a substitute is actually picked — which periods still
// NEED coverage is computed live from Timetable + TeacherAttendance, never
// pre-persisted as placeholder rows.
model SubstituteAssignment {
  id                    String     @id @default(uuid())
  school_id             String
  original_teacher_id   String
  substitute_teacher_id String
  class_id              String
  subject_id            String?
  timetable_id          String?
  date                  DateTime
  start_time            String?
  end_time              String?
  // 'Assigned' (just picked, awaiting the substitute's response) | 'Accepted'
  // | 'Declined' (frees the period back up for reassignment) | 'Completed'
  status                String     @default("Assigned")
  notified_at           DateTime?
  responded_at          DateTime?
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt
  school                School     @relation(fields: [school_id], references: [id], onDelete: Cascade)
  timetable             Timetable? @relation(fields: [timetable_id], references: [id])
  branch_id             String?
  created_by            String?
  updated_by            String?
  deleted_at            DateTime?

  @@index([timetable_id, date])
  @@index([school_id, date])
  @@index([substitute_teacher_id, status])
}

// STUDENT EARLY WARNING SYSTEM — rules-based nightly scan flags at-risk
// students from attendance, homework, fees, behaviour, exam scores, and
// lateness. One active flag per student at a time; re-scoring overwrites it
// rather than piling up duplicate rows.
model StudentRiskFlag {
  id          String    @id @default(uuid())
  school_id   String
  branch_id   String?
  student_id  String
  score       Int
  level       String // Low | Medium | High
  reasons     Json // [{ category, detail }]
  status      String    @default("Active") // Active | Resolved
  resolved_at DateTime?
  resolved_by String?
  computed_at DateTime  @default(now())
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  school      School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id])
  @@index([school_id, status])
}

// SCHOOL TIMELINE — a chronological life-event feed per student or teacher.
// subject_type/subject_id is a lightweight polymorphic reference (no
// enforced Prisma relation), same pattern as SubstituteAssignment's
// class_id/subject_id, since it points at two different models.
model LifeEvent {
  id           String   @id @default(uuid())
  school_id    String
  branch_id    String?
  subject_type String // student | teacher
  subject_id   String
  event_type   String // Admission | Achievement | Suspension | Graduation | Transfer | Withdrawal | Hired | Custom
  title        String
  description  String?
  event_date   DateTime
  icon         String?
  color        String?
  source       String   @default("manual") // auto | manual
  created_by   String?
  created_at   DateTime @default(now())
  school       School   @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id, subject_type, subject_id])
}

// CLASSROOM OBSERVATION MODULE — a versioned scoring rubric (lesson prep,
// teaching method, participation, classroom management, time management)
// an admin fills in while observing a teacher's class, structurally similar
// to the school-inspection engine but scoped to one teacher/class/date.
model ObservationTemplate {
  id           String                 @id @default(uuid())
  school_id    String? // null = global default template
  name         String
  criteria     Json // [{ key, label, max_score }]
  version      Int                    @default(1)
  is_active    Boolean                @default(true)
  created_at   DateTime               @default(now())
  observations ClassroomObservation[]
}

model ClassroomObservation {
  id            String                @id @default(uuid())
  school_id     String
  branch_id     String?
  template_id   String
  teacher_id    String
  class_id      String?
  observer_id   String
  date          DateTime
  status        String                @default("Submitted") // Draft | Submitted
  overall_score Float?
  overall_grade String?
  notes         String?
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt
  deleted_at    DateTime?
  school        School                @relation(fields: [school_id], references: [id], onDelete: Cascade)
  template      ObservationTemplate   @relation(fields: [template_id], references: [id])
  responses     ObservationResponse[]

  @@index([teacher_id, date])
  @@index([school_id, date])
}

model ObservationResponse {
  id             String               @id @default(uuid())
  observation_id String
  criterion_key  String
  score          Float
  comment        String?
  observation    ClassroomObservation @relation(fields: [observation_id], references: [id], onDelete: Cascade)

  @@index([observation_id])
}

