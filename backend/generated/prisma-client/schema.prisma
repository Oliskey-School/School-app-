  branch_id        String?
  created_by       String?
  updated_by       String?
  deleted_at       DateTime?
}

model RolePermission {
  id            String    @id @default(uuid())
  school_id     String
  role          String
  permission_id String
  enabled       Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  branch_id     String?
  created_by    String?
  updated_by    String?
  deleted_at    DateTime?

  @@unique([school_id, role, permission_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model StudentIDCard {
  id          String   @id @default(uuid())
  school_id   String
  student_id  String
  card_number String   @unique
  issue_date  DateTime @default(now())
  expiry_date DateTime
  status      String   @default("Active")
  is_printed  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  school     School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  branch_id  String?
  created_by String?
  updated_by String?
  deleted_at DateTime?

  @@index([school_id])
  @@index([student_id])
}

model PaymentPlan {
  id                Int           @id @default(autoincrement())
  fee_id            String
  student_id        String
  total_amount      Float
  installment_count Int
  frequency         String
  status            String        @default("active")
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  student           Student       @relation(fields: [student_id], references: [id], onDelete: Cascade)
  installments      Installment[]
  school_id         String
  branch_id         String?
  created_by        String?
  updated_by        String?
  deleted_at        DateTime?

  @@index([student_id])
  @@index([fee_id])
}

model Installment {
  id                 Int         @id @default(autoincrement())
  payment_plan_id    Int
  installment_number Int
  due_date           DateTime
  amount             Float?
  paid_amount        Float?      @default(0)
  status             String      @default("pending")
  transaction_id     Int?
  created_at         DateTime    @default(now())
  payment_plan       PaymentPlan @relation(fields: [payment_plan_id], references: [id], onDelete: Cascade)
  school_id          String
  branch_id          String?
  created_by         String?
  updated_by         String?
  deleted_at         DateTime?

  @@index([payment_plan_id])
  @@index([due_date])
}

model StoreProduct {
  id          String    @id @default(uuid())
  school_id   String
  name        String
  description String?
  category    String?
  price       Float
  stock       Int       @default(0)
  image_url   String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  school      School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  branch_id   String?
  created_by  String?
  updated_by  String?
  deleted_at  DateTime?

  @@index([school_id])
  @@index([category])
}

model StoreOrder {
  id             String           @id @default(uuid())
  school_id      String
  customer_name  String
  customer_email String?
  total_amount   Float
  status         String           @default("Pending")
  order_date     DateTime         @default(now())
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  school         School           @relation(fields: [school_id], references: [id], onDelete: Cascade)
  items          StoreOrderItem[]
  branch_id      String?
  created_by     String?
  updated_by     String?
  deleted_at     DateTime?

  @@index([school_id])
  @@index([status])
}

model StoreOrderItem {
  id           String     @id @default(uuid())
  order_id     String
  product_name String
  quantity     Int        @default(1)
  unit_price   Float
  subtotal     Float
  order        StoreOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  school_id    String
  branch_id    String?
  created_by   String?
  updated_by   String?
  deleted_at   DateTime?

  @@index([order_id])
}

enum Role {
  SUPER_ADMIN
  PROPRIETOR
  ADMIN
  TEACHER
  STUDENT
  PARENT
  BURSAR
  INSPECTOR
  EXAM_OFFICER
  COMPLIANCE_OFFICER
}

// Academic calendar — Lagos State / Nigerian term dates.
// Edited by SuperAdmin each July when Lagos releases the new session calendar.
model AcademicCalendar {
  id              Int      @id @default(autoincrement())
  session         String // e.g. '2025/2026'
  term            Int // 1 | 2 | 3
  resumption_date DateTime
  closing_date    DateTime
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([session, term])
  @@index([resumption_date])
  @@index([closing_date])
}

// PWA install prompt analytics — one row per user interaction with the
// "Install School App" prompt. user_id is a plain (non-FK) column so demo
// users, who are not real `users` rows, can still be recorded. Used to
// know which users installed the app and to sync the "Not Now" dismissal
// across a user's devices.
model PwaInstallEvent {
  id         String    @id @default(uuid())
  user_id    String
  school_id  String
  branch_id  String?
  action     String // shown | install_clicked | installed | dismissed | instructions_shown | prompt_declined
  platform   String? // ios | android | desktop | other
  user_agent String?
  created_at DateTime  @default(now())
  created_by String?
  updated_by String?
  deleted_at DateTime?

  @@index([user_id])
  @@index([school_id])
  @@index([action])
  @@index([created_at])
}
