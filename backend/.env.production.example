# =============================================================================
# BACKEND (Express) — PRODUCTION ENV TEMPLATE
# Set these on your backend host (Railway / Render / Fly / etc).
# NEVER commit real values. In production the server REFUSES TO BOOT if the
# required secrets are missing or weak (see backend/src/config/env.ts).
#
# Generate strong secrets with:  openssl rand -base64 48
# =============================================================================

NODE_ENV=production
BACKEND_PORT=5000

# --- Database (Postgres / Supabase) — REQUIRED ---
# DIRECT_URL is used by Prisma migrations; DATABASE_URL by the running app.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Auth secrets — REQUIRED, >=32 chars, MUST differ from each other ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-DIFFERENT-long-random-string-min-32

# --- Supabase service role (server-side only; NOT the anon key) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Demo school identity — REQUIRED in production ---
DEMO_SCHOOL_ID=your-demo-school-uuid
DEMO_BRANCH_ID=your-demo-branch-uuid

# --- Whole-app translation (Gemini key; server-side only, never shipped to browser) ---
# Without this, translation degrades gracefully to English.
GOOGLE_TRANSLATE_API_KEY=your-gemini-api-key

# --- Payments (server-side SECRET keys) ---
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxx

# --- CORS: production frontend domain(s), comma-separated ---
# The default *.vercel.app domains are already allow-listed in code.
# Add any CUSTOM domain here, e.g. https://app.yourschool.com
CORS_ALLOWED_ORIGINS=https://your-custom-domain.com
