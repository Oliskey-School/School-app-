# =============================================================================
# BACKEND (Express) — PRODUCTION ENV TEMPLATE
# Set these in backend/.env on the production VPS. NEVER commit real values.
# The server REFUSES TO BOOT if the required secrets below are missing or
# weak — see backend/src/config/env.ts.
#
# Generate strong secrets with:  openssl rand -base64 48
# =============================================================================

NODE_ENV=production
BACKEND_PORT=5000

# --- Database (Postgres) — REQUIRED ---
# DIRECT_URL is used by Prisma Migrate (needs a direct, non-pooled session);
# DATABASE_URL is used by the running app.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Auth secrets — REQUIRED, >=32 chars, MUST differ from each other ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-DIFFERENT-long-random-string-min-32

# --- Demo school identity — REQUIRED in production ---
DEMO_SCHOOL_ID=your-demo-school-uuid
DEMO_BRANCH_ID=your-demo-branch-uuid

# --- Demo seeder — safe to leave on; only upserts deterministic demo
# records, never touches real school data. ---
RUN_DEMO_SEEDER=true

# --- CORS — leave false in production. nginx serves the SPA and proxies
# /api same-origin (see deploy/nginx.conf), so the browser never needs CORS
# headers. Only set true if the API is deployed on a different origin than
# the frontend without a same-origin proxy in front of it. ---
ENABLE_CORS=false

# --- Trust proxy hop count — 1 for the standard nginx-in-front setup. ---
TRUST_PROXY=1

# --- Redis — required for correct rate limiting/CSRF replay protection
# across more than one backend instance; falls back to safe in-memory
# behaviour if unreachable. ---
REDIS_URL=redis://localhost:6379
SOCKET_REDIS_ADAPTER=false

# --- Whole-app translation (server-side only; degrades to English if unset) ---
GOOGLE_TRANSLATE_API_KEY=your-gemini-api-key

# --- AI (NVIDIA is the default provider, proxied through this backend) ---
NVIDIA_API_KEY=your-nvidia-api-key

# --- Payments (server-side SECRET keys — LIVE keys for production, never
# the frontend's PUBLIC keys) ---
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxx

# --- Google Sign-In — must match the frontend's VITE_GOOGLE_CLIENT_ID ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Daily.co (live-class video) — leave unset to use the Jitsi path instead ---
DAILY_API_KEY=

# --- SMTP ---
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- App URL (used in email templates) ---
APP_URL=https://oliskeysms.duckdns.org

# --- File uploads (student/teacher photos, documents, assignments,
# resources). STRONGLY RECOMMENDED for production: local disk works today
# because this is a single persistent VPS, but has no redundancy — a disk
# failure loses every uploaded file permanently, and it breaks outright the
# moment the app ever runs as more than one instance. Set S3_ENABLED=true
# and fill in the rest once you have an S3-compatible bucket (AWS S3,
# Cloudflare R2, Backblaze B2, DigitalOcean Spaces, Contabo Object Storage,
# ...). Leaving S3_ENABLED=false keeps the current local-disk behavior. ---
S3_ENABLED=false
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL_BASE=

# --- Error monitoring (optional but recommended in production) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
