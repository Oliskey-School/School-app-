# Keep `vercel deploy` from uploading the whole working tree.
#
# Without this the CLI tried to upload 15,919 files / 560MB and failed twice
# ("files should NOT have more than 15000 items", then a network reset).
# Vercel installs dependencies and builds on its own runner, so none of this
# needs to travel.

node_modules
dist
.git

# Local build/test artifacts
.vite
.playwright-report
.playwright-results
.playwright-results-backup
coverage
*.log

# Generated Prisma clients — regenerated by postinstall on the build runner,
# and the Windows engine binary here is useless on Vercel's Linux runtime.
generated
backend/generated
backend/dist

# Runtime data that must never be part of a deployment artifact
uploads
database_backup.sql

# Local tooling and agent skills
.agents
.claude
.kilo
.opencode
.gemini
skills
skill-observations
graphify-out

# Server-only deployment material (the VPS setup, not used by Vercel)
deploy
