# =============================================================================
# FRONTEND (Vite) — PRODUCTION ENV TEMPLATE
# Set these in .env on the production VPS before `npm run build`. Only
# VITE_-prefixed vars are exposed to the browser bundle — never put a
# server-side secret (payment secret key, SMTP password, JWT secret) in here.
# =============================================================================

# --- API / Socket URL overrides ---
# Usually left UNSET in production: lib/config.ts already defaults to
# same-origin (/api and the page's own origin) when nothing is set, which is
# correct for the standard deploy/nginx.conf setup (nginx proxies /api and
# /socket.io same-origin — no CORS needed). Only set these if the API is
# ever deployed on a different origin than the frontend.
# VITE_API_URL=
# VITE_SOCKET_URL=

# --- AI ---
# NVIDIA is the default provider, proxied entirely through the backend (see
# backend NVIDIA_API_KEY) — no browser-side key needed, none of it reaches
# the client bundle. Leave VITE_AI_PROVIDER unset / VITE_GEMINI_API_KEY blank
# in production. Only set these two if you deliberately want the legacy path
# that calls Google's Gemini API directly from the browser (dev/testing
# only — the key WILL be visible in the built JS).
VITE_AI_PROVIDER=nvidia
# VITE_GEMINI_API_KEY=

# --- Google Sign-In (public client ID — must match backend's GOOGLE_CLIENT_ID,
# which verifies the ID token's `aud` claim against it) ---
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Payments (PUBLIC keys only — the matching SECRET keys live in
# backend/.env, never here) ---
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxx

# --- App metadata ---
VITE_APP_NAME=Oliskey School Management
VITE_APP_VERSION=0.7.10

# --- Error monitoring — set this so production errors are reported
# (otherwise silent) ---
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Backend (set in backend/.env): SENTRY_DSN= , SENTRY_TRACES_SAMPLE_RATE=0.1
