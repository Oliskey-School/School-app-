# =============================================================================
# FRONTEND (Vite) — PRODUCTION ENV TEMPLATE
# Set these in your Vercel project settings (Environment Variables → Production).
# Only VITE_-prefixed vars are exposed to the browser bundle. Never put a
# server-side secret (service key / payment secret) in here.
# Copy to .env.production and fill in real values, OR set them in Vercel directly.
# =============================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI features (Gemini)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Payments (PUBLIC keys only)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxx

VITE_RESEND_API_KEY=
VITE_APP_NAME=Oliskey School
VITE_APP_VERSION=1.0.0

# Error monitoring — set this so production errors are reported (otherwise silent)
VITE_SENTRY_DSN=https://xxxxx@oXXXX.ingest.sentry.io/XXXX
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
