# Playwright e2e screenshot output (regenerated per run, not fixtures)
tests/e2e/shots/

# Graphify local knowledge graph (regenerate with: graphify update .)
graphify-out/

# Claude agent worktrees
.claude/worktrees/

# Expo/React Native web cache (regenerated automatically, never needs to be tracked)
.expo/
dev-dist/
backend/generated/

# Local debugging scratch files. Kept out of the repo because
# _debug_admin_real*.mjs contain working login credentials for accounts on
# the live system, and the .png/.json dumps can capture real school data.
_debug_*
FAIL.md
PASS.md

# Generated database backup artifacts
backups/
