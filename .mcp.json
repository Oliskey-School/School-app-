{
  "mcpServers": {
    "postgres": {
      "command": "node",
      "args": [
        "mcp/server.mjs"
      ],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ikowlorheeyrsbgvlhvg"
    },
    "MCP_DOCKER": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--profile",
        "claude"
      ],
      "env": {
        "LOCALAPPDATA": "C:\\Users\\USER\\AppData\\Local",
        "ProgramData": "C:\\ProgramData",
        "ProgramFiles": "C:\\Program Files"
      },
      "type": "stdio"
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST}"
      }
    }
  }
}
