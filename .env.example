# =====================================================
# Frontend (Vite) environment variables.
# Copy this file to `.env` and fill in real values.
# Anything prefixed with VITE_ is exposed to the browser bundle — never put secrets here.
# =====================================================

# --- Supabase (browser-side, anon key only) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- AI ---
# NVIDIA is the default AI provider, powered entirely through the backend proxy
# (see backend NVIDIA_API_KEY) — no browser-side key needed and none of it reaches
# the client bundle. Leave VITE_AI_PROVIDER unset / VITE_GEMINI_API_KEY blank in
# production. Only set these two if you deliberately want the legacy path that
# calls Google's Gemini API directly from the browser (dev/testing only — the
# key WILL be visible in the built JS).
VITE_AI_PROVIDER=nvidia
# VITE_GEMINI_API_KEY=your-gemini-api-key

# --- Payments ---
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx

# --- Push notifications (optional; leave blank if not using Firebase web push) ---
VITE_FIREBASE_VAPID_KEY=

# --- App metadata ---
VITE_APP_NAME=Oliskey School Management
VITE_APP_VERSION=0.7.7

# --- Error tracking (optional; leave blank to disable) ---
# Frontend crash reporting. Paste the DSN from your Sentry project to enable.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Backend (set in backend/.env): SENTRY_DSN= , SENTRY_TRACES_SAMPLE_RATE=0.1
