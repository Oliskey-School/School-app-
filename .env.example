# =====================================================
# Frontend (Vite) environment variables.
# Copy this file to `.env` and fill in real values.
# Anything prefixed with VITE_ is exposed to the browser bundle — never put secrets here.
# =====================================================

# --- Supabase (browser-side, anon key only) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- AI ---
VITE_GEMINI_API_KEY=your-gemini-api-key

# --- Payments ---
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx

# --- Transactional email (frontend forms) ---
VITE_RESEND_API_KEY=re_xxx

# --- App metadata ---
VITE_APP_NAME=Oliskey School Management
VITE_APP_VERSION=0.5.41

# --- Error tracking (optional; leave blank to disable) ---
# Frontend crash reporting. Paste the DSN from your Sentry project to enable.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Backend (set in backend/.env): SENTRY_DSN= , SENTRY_TRACES_SAMPLE_RATE=0.1
